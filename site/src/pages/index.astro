---
import { existsSync } from "node:fs";
import Site from "../layouts/Site.astro";
import Icon from "../components/Icon.astro";

// The hero GIF is not committed yet (see docs/media/README.md). Until it is,
// a real phone screenshot stands in; the GIF wins when it appears.
const hasHero = existsSync(new URL("../../public/media/hero.gif", import.meta.url));
const hasStill = existsSync(new URL("../../public/media/phone-terminal.png", import.meta.url));

const repo = "https://github.com/zalify/offdesk";
const docs = `${repo}#readme`;
// /apk redirects to the newest app-v* release — see site/worker.js.
const apk = "https://offdesk.dev/apk";
const description =
  "Vibe code from your phone on the terminal you left at home. One line, one scan, and you're in.";
const install = "curl -fsSL https://offdesk.dev/install | sh";

const tunnel = [
  "git clone https://github.com/zalify/offdesk && cd offdesk",
  "$EDITOR .env   # OFFDESK_BASE_URL, TUNNEL_TOKEN, OAuth",
  "docker compose --profile tunnel up -d --build",
].join("\n");

const join = [
  "curl -fsSL https://offdesk.dev/install \\",
  "  | sh -s -- --hub-url ws://192.168.1.10:4317/ws/machine \\",
  "  --token <token>",
].join("\n");

const orchestration = `T=$(offdesk open nas --cwd ~/app --cmd claude --json | jq -r .id)
offdesk send $T \\
  "fix the type errors in src/auth.ts; stop when tests pass"
offdesk wait $T --silence 5000 --timeout 600
offdesk read $T --lines 80`;

const agents = [
  "Claude Code",
  "Codex",
  "OpenCode",
  "Gemini CLI",
  "Aider",
  "vim",
  "htop",
  "pnpm dev",
  "any CLI",
];

// Every cell is from the vendor's own documentation, checked 2026-09-01.
// Sources are in README.md, under the same table.
const columns = [
  "Any terminal program",
  "Machines per hub",
  "Traffic goes through",
  "Agents can drive it via CLI",
  "Self-hosted",
];
const rows = [
  { name: "offdesk", self: true, cells: ["Anything that runs in tmux", "Any number, one URL", "Your own hub", "open / send / wait / read", "Yes, MIT"] },
  { name: "Claude Code Remote Control", cells: ["No — a Claude Code session, not a terminal", "Sessions from several machines in one list", "Anthropic's servers; transcript stored there", "Not documented", "No"] },
  { name: "VibeTunnel", cells: ["Yes — vt <any command>, vt --shell", "One server per machine", "Your choice: LAN, Tailscale, ngrok, Cloudflare", "Launches commands only", "Yes, MIT"] },
  { name: "Happy Coder", cells: ["No — wraps claude and codex", "Several; spawn --machine", "slopus cloud by default, end-to-end encrypted", "create / send / history / wait", "Optional, MIT"] },
  { name: "Omnara", cells: ["Agent sessions; no raw terminal documented", "Several at once per agent", "api.omnara.com by default", "CLI and REST", "Optional, Apache-2.0"] },
  { name: "Orca", cells: ["Yes — real terminal, 30+ CLI agents", "Several, via SSH worktrees and orca serve", "Orca Relay by default, or direct on the LAN", "orca terminal create/send/read/wait", "Yes, MIT"] },
];
---

<Site title="offdesk — vibe code from your phone" description={description}>
  <!-- Hero: the whole first setup, on the machine at home. -->
  <section class="mx-auto max-w-6xl px-6 pt-10 pb-16 md:pt-16 md:pb-24">
    <div class="grid items-center gap-14 lg:grid-cols-[1.1fr_1fr] lg:gap-12">
      <div class="min-w-0">
        <p class="eyebrow inline-flex items-center gap-2">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="5" fill="#ffc857" />
            <g stroke="#ff6b57" stroke-width="2" stroke-linecap="round">
              <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1" />
            </g>
          </svg>
          Vibe code from the beach
        </p>
        <h1 class="display mt-4 text-5xl leading-[1.02] md:text-6xl">
          Your terminal stays home. You don't have to.
        </h1>
        <p class="prose-lead mt-6 max-w-xl">
          The Mac at home keeps running Claude Code. Your phone opens the same
          terminal, mid-scroll, from the sand. One line to set up, one scan to
          get in.
        </p>

        <ol class="mt-10 space-y-8">
          <li class="flex gap-4">
            <span class="step mt-0.5">1</span>
            <div class="min-w-0 flex-1">
              <p class="font-display text-lg font-semibold text-ink">
                On the machine that stays on, run this
              </p>
              <div class="cmd mt-3">
                <pre class="min-w-0 flex-1 overflow-x-auto whitespace-pre"><code><span class="cmd-prompt">$ </span>{install}</code></pre>
                <button type="button" class="cmd-copy" data-copy={install} aria-label="Copy the install command">Copy</button>
              </div>
              <p class="prose-body mt-3 text-[15px]">
                It installs everything, starts the hub as a service that survives
                reboots, and registers this machine with it. A Mac or a NAS on
                your Wi-Fi is perfect. No account, no cloud, no config.
              </p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="step mt-0.5">2</span>
            <div class="min-w-0 flex-1">
              <p class="font-display text-lg font-semibold text-ink">
                Scan the code it prints
              </p>
              <p class="prose-body mt-2 text-[15px]">
                With your phone's camera, or the Android app. That's the
                sign-in. Need it again later? <span class="inline-code">offdesk link</span>.
              </p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="step mt-0.5">3</span>
            <div class="min-w-0 flex-1">
              <p class="font-display text-lg font-semibold text-ink">
                That's your terminal. Go outside.
              </p>
              <p class="prose-body mt-2 text-[15px]">
                Same tmux session as the desk, live. Close the laptop; nothing
                stops. Anything that runs in tmux runs here.
              </p>
            </div>
          </li>
        </ol>

        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a href={apk} class="btn-coral">Android app</a>
          <a href={docs} class="btn-sky">Read the docs</a>
          <span class="font-display text-[14px] font-semibold text-muted">iPhone: just the browser</span>
        </div>
      </div>

      {
        hasHero ? (
          <figure class="overflow-hidden rounded-[28px] border border-line bg-term shadow-[12px_12px_0_0_#ffc857]">
            <img src="/media/hero.gif" alt="Claude Code on a desk machine while a phone is attached to the same tmux session" width="1200" height="750" loading="eager" class="block w-full" />
          </figure>
        ) : hasStill ? (
          <figure class="relative mx-auto w-full max-w-[21rem] lg:justify-self-end">
            <div aria-hidden="true" class="absolute -top-8 -left-10 h-24 w-24 rounded-full bg-pink/60"></div>
            <div aria-hidden="true" class="absolute -right-8 bottom-16 h-16 w-16 rounded-full border-[10px] border-sun"></div>
            <div class="relative overflow-hidden rounded-[2.4rem] border-[6px] border-ink bg-term shadow-[14px_14px_0_0_#ffc857]">
              <img src="/media/phone-terminal.png" alt="An offdesk terminal on a phone: Claude Code on a Mac at home, attached from the phone's browser" width="390" height="844" loading="eager" class="block w-full" />
            </div>
            <figcaption class="mt-5 text-center font-display text-[14px] font-semibold text-muted">
              Real terminal. Real Mac at home. Real beach optional.
            </figcaption>
          </figure>
        ) : null
      }
    </div>
  </section>

  <!-- Wave -->
  <div aria-hidden="true" class="-mb-1">
    <svg viewBox="0 0 1440 60" class="block h-10 w-full md:h-14" preserveAspectRatio="none">
      <path d="M0 30 C 180 60, 360 0, 540 30 S 900 60, 1080 30 S 1350 0, 1440 30 L1440 60 L0 60 Z" fill="#fffbf4" />
    </svg>
  </div>

  <!-- How it works -->
  <section id="how" class="bg-cream">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
      <p class="eyebrow">How it works</p>
      <h2 class="display mt-3 max-w-2xl text-4xl md:text-5xl">
        Three small things, and nothing in the middle.
      </h2>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <div class="card">
          <div class="flex items-center gap-3">
            <span class="step">1</span>
            <h3 class="display text-2xl">Hub</h3>
          </div>
          <p class="prose-body mt-4">
            One process on the machine that stays on. SQLite beside it, the web
            UI baked in. It's the only address your phone ever needs.
          </p>
          <code class="mt-4 block font-mono text-[12px] text-faint">offdesk-hub</code>
        </div>
        <div class="card">
          <div class="flex items-center gap-3">
            <span class="step">2</span>
            <h3 class="display text-2xl">Node</h3>
          </div>
          <p class="prose-body mt-4">
            On every machine you want to reach. It dials <em>out</em> to the
            hub and keeps one socket open, so nothing needs a port or a public IP.
          </p>
          <code class="mt-4 block font-mono text-[12px] text-faint">offdesk-node</code>
        </div>
        <div class="card">
          <div class="flex items-center gap-3">
            <span class="step">3</span>
            <h3 class="display text-2xl">Terminal</h3>
          </div>
          <p class="prose-body mt-4">
            A tmux session on the machine that owns it. It outlives the app, the
            network, and you walking away. Uninstall offdesk and it's still there.
          </p>
          <code class="mt-4 block font-mono text-[12px] text-faint">tmux</code>
        </div>
      </div>
      <p class="prose-body mt-8 max-w-2xl">
        Two screens on one terminal: whoever typed last holds the keyboard,
        everyone else watches live. A phone attaching never resizes the desk;
        a phone typing does, and the desk gets a one-click fit back.
      </p>
    </div>
  </section>

  <!-- Away from home: the tunnel -->
  <section id="away" class="mx-auto max-w-6xl px-6 py-16 md:py-24">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
      <div>
        <p class="eyebrow">Away from home</p>
        <h2 class="display mt-3 text-4xl md:text-5xl">
          Not on the Wi-Fi? Tunnel home.
        </h2>
        <p class="prose-lead mt-6">
          A Cloudflare Tunnel runs next to the hub and dials out, so the hub at
          home gets an <span class="inline-code">https://</span> address with
          no port opened, no DNS to babysit, and it works behind CGNAT. The free
          plan is enough.
        </p>
        <p class="prose-body mt-4">
          The trade: Cloudflare sees your terminal traffic in the clear. If
          that's a no, a <a href={`${repo}/blob/main/docs/setup-public.md#tailscale`}>tailnet</a>
          puts nobody in the middle, and a
          <a href={`${repo}/blob/main/docs/setup-public.md#a-vps-behind-caddy`}>VPS behind Caddy</a>
          is the classic. Same binaries, all three.
        </p>
        <a href="/tunnel" class="btn-coral mt-8">The tunnel guide</a>
      </div>
      <div class="card min-w-0">
        <p class="font-display text-lg font-semibold text-ink">On the machine at home</p>
        <p class="prose-body mt-2 text-[15px]">
          Create the tunnel in Cloudflare's dashboard, point it at
          <span class="inline-code">server:4317</span>, drop its token in
          <span class="inline-code">.env</span>, and:
        </p>
        <div class="cmd mt-5">
          <pre class="min-w-0 flex-1 overflow-x-auto whitespace-pre"><code>{tunnel.split("\n").map((line) => (<span class="block"><span class="cmd-prompt">$ </span>{line}</span>))}</code></pre>
          <button type="button" class="cmd-copy" data-copy={tunnel} aria-label="Copy the tunnel commands">Copy</button>
        </div>
        <p class="prose-body mt-4 text-[15px]">
          Sign-in becomes GitHub or Google, because the address is on the
          internet now. Everything else — the scan, the phone, the machines — is
          the same as at home.
        </p>
      </div>
    </div>
  </section>

  <!-- More scenarios -->
  <section id="more" class="bg-cream">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
      <p class="eyebrow">More</p>
      <h2 class="display mt-3 max-w-2xl text-4xl md:text-5xl">
        A second machine, the phone, the agents.
      </h2>
      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        <div class="card min-w-0">
          <h3 class="display text-2xl">A second machine</h3>
          <p class="prose-body mt-3">
            The NAS, the VPS, the laptop. Open the hub, choose <strong>Add
            host</strong>, and it hands you one line with a token in it. Paste it
            on that machine; it shows up.
          </p>
          <pre class="term mt-5 overflow-x-auto p-4 text-[12.5px]"><code>{join}</code></pre>
        </div>
        <div class="card min-w-0">
          <h3 class="display text-2xl">Your phone</h3>
          <p class="prose-body mt-3">
            The browser is the whole client — iPhone included. A key bar for
            Ctrl, Esc and the arrows, because agents ask questions and builds
            need a Ctrl‑C. The Android app adds native notifications and scans
            the code itself.
          </p>
          <div class="mt-5 flex flex-wrap gap-2">
            <a href={apk} class="btn-coral px-5 py-2.5 text-[14px]">Download the APK</a>
            <a href="https://offdesk.dev/apk/universal" class="btn-sky px-5 py-2.5 text-[14px]">universal build</a>
          </div>
        </div>
        <div class="card min-w-0">
          <h3 class="display text-2xl">Bring any agent</h3>
          <p class="prose-body mt-3">
            offdesk doesn't wrap an agent or speak its protocol. It hands you the
            terminal the agent already runs in — your subscription, your config,
            your dotfiles.
          </p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {agents.map((a) => (<li class="rounded-full border-2 border-line-2 bg-sand px-3 py-1 font-mono text-[12.5px] text-ink">{a}</li>))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- For agents -->
  <section id="agents" class="mx-auto max-w-6xl px-6 py-16 md:py-24">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-14">
      <div>
        <p class="eyebrow">For agents</p>
        <h2 class="display mt-3 text-4xl md:text-5xl">
          One token, and any agent can drive any machine you own.
        </h2>
        <p class="prose-lead mt-6">
          Open a terminal on any registered machine, type into it, wait for it
          to go quiet, read it back. Not an agent session — a terminal, so what
          you drive is what you'd have run by hand.
        </p>
        <p class="prose-body mt-4">
          A token is remote code execution on every machine you registered.
          Mint one per agent, name it, revoke it alone.
          <a href={`${repo}/blob/main/SECURITY.md`}>SECURITY.md</a>
        </p>
      </div>
      <div class="cmd min-w-0">
        <pre class="min-w-0 flex-1 overflow-x-auto whitespace-pre text-[12.5px]"><code>{orchestration}</code></pre>
        <button type="button" class="cmd-copy" data-copy={orchestration} aria-label="Copy the example">Copy</button>
      </div>
    </div>
  </section>

  <!-- Compare -->
  <section id="compare" class="bg-cream">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
      <p class="eyebrow">How it compares</p>
      <h2 class="display mt-3 max-w-3xl text-3xl md:text-4xl">
        The ones that gather machines hand you a chat. The ones that hand you a terminal run one server per machine.
      </h2>
      <p class="prose-body mt-4 max-w-2xl">
        Every cell is from that project's own documentation, checked
        2026-09-01. Sources are under the same table in the README.
      </p>
      <div class="mt-8 overflow-x-auto rounded-[22px] border border-line bg-sand">
        <table class="w-full min-w-[56rem] border-collapse text-left text-[14px]">
          <thead>
            <tr>
              <th scope="col" class="px-4 py-3"></th>
              {columns.map((c) => <th scope="col" class="px-4 py-3 align-bottom font-display text-[13px] font-semibold text-muted">{c}</th>)}
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr class:list={["border-t border-line", { "bg-sun/25": row.self }]}>
                <th scope="row" class:list={["px-4 py-3 align-top font-display font-semibold", row.self ? "text-coral" : "text-ink"]}>{row.name}</th>
                {row.cells.map((cell) => (
                  <td class:list={["px-4 py-3 align-top leading-snug", /not documented/i.test(cell) ? "text-faint" : "text-ink-2"]}>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Close -->
  <section class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <div class="relative max-w-3xl">
      <div aria-hidden="true" class="absolute -top-10 right-0 h-20 w-20 rounded-full border-[12px] border-coral/70 md:-right-24"></div>
      <h2 class="display text-4xl md:text-6xl">Go on. Close the laptop.</h2>
      <p class="prose-lead mt-6 max-w-xl">
        The session keeps running at home. Your phone opens the same terminal,
        mid-scroll.
      </p>
      <div class="cmd mt-9 max-w-xl">
        <pre class="min-w-0 flex-1 overflow-x-auto whitespace-pre"><code><span class="cmd-prompt">$ </span>{install}</code></pre>
        <button type="button" class="cmd-copy" data-copy={install} aria-label="Copy the install command">Copy</button>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={repo} class="btn-coral"><Icon name="github" />GitHub</a>
        <a href="https://discord.gg/aFUu6VMzc" class="btn-sky"><Icon name="discord" />Discord</a>
        <a href={apk} class="btn-sky">Android app</a>
      </div>
    </div>
  </section>
</Site>
